#!/bin/bash
# Service to configure USB gadget interface and prevent link-local addressing conflicts
#
# The LCD's USB network link (eth1) disappears and comes back without an
# address whenever the LCD restarts (software update, power blip, cable
# replug) while this machine stays on. So besides configuring it at start,
# a small watcher puts the address back whenever eth1 is there without it.

IFACE=eth1
ADDR=169.254.100.2
PIDFILE=/var/run/pixelcade_lcd_watch.pid

configure() {
    ifconfig $IFACE down
    ifconfig $IFACE $ADDR netmask 255.255.0.0 up
    echo 1 > /proc/sys/net/ipv6/conf/$IFACE/disable_ipv6
}

watch_link() {
    while true; do
        if ip link show $IFACE > /dev/null 2>&1 && ! ip -4 addr show $IFACE | grep -q "inet $ADDR/"; then
            configure
        fi
        sleep 5
    done
}

case "$1" in
    start)
        for i in $(seq 1 10); do
            if ip link show $IFACE > /dev/null 2>&1; then
                configure
                break
            fi
            sleep 1
        done
        if [ -f $PIDFILE ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
            exit 0
        fi
        watch_link > /dev/null 2>&1 &
        echo $! > $PIDFILE
        ;;

    stop)
        if [ -f $PIDFILE ]; then
            kill "$(cat $PIDFILE)" 2>/dev/null
            rm -f $PIDFILE
        fi
        ;;

    restart|reload)
        # Restart the service
        $0 stop
        $0 start
        ;;

    *)
        # Default action
        echo "Usage: $0 {start|stop|restart|reload}"
        exit 1
        ;;
esac

exit 0
